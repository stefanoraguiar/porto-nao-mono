---
// File: src/layouts/BaseLayout.astro
interface Props {
  title: string;
  /** When true, ask search engines not to index this page (unlisted links). */
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;

const navLinks = [
  { href: '/quem-somos', label: 'Quem Somos' },
  { href: '/articles', label: 'Artigos' },
  { href: '/events', label: 'Eventos' },
  { href: '/biblioteca', label: 'Biblioteca' },
  { href: '/gallery', label: 'Galeria' },
  { href: '/professionals', label: 'Profissionais' },
];
---

<!DOCTYPE html>
<html lang="pt" class="bg-slate-50 text-slate-800 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Porto Não-Monogâmico</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#7c3aed" />

    <style is:global>
        @import "tailwindcss";
    </style>
  </head>
  <body class="min-h-screen flex flex-col font-sans">
    
    <!-- Top Navigation Bar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
        
        <!-- Site Logo / Brand -->
        <a href="/" class="flex items-center gap-2.5 min-w-0 group">
          <img
            src="/images/PNM_logo.png"
            alt=""
            width="40"
            height="40"
            class="h-9 w-9 sm:h-10 sm:w-10 rounded-lg object-cover shrink-0 shadow-sm ring-1 ring-black/10"
          />
          <span class="font-bold text-base sm:text-lg text-indigo-900 group-hover:text-indigo-600 transition truncate">
            Porto Não-Monogâmico
          </span>
        </a>

        <!-- Desktop navigation -->
        <nav class="hidden md:flex items-center gap-5 text-sm font-medium text-slate-600" aria-label="Principal">
          {navLinks.map((link) => (
            <a href={link.href} class="hover:text-indigo-600 transition whitespace-nowrap">
              {link.label}
            </a>
          ))}
        </nav>

        <!-- Mobile menu button -->
        <button
          type="button"
          id="nav-toggle"
          class="md:hidden inline-flex items-center justify-center h-10 w-10 rounded-lg text-slate-700 hover:bg-slate-100 transition shrink-0"
          aria-controls="mobile-nav"
          aria-expanded="false"
          aria-label="Abrir menu"
        >
          <svg id="nav-icon-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
          </svg>
          <svg id="nav-icon-close" class="h-6 w-6 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <!-- Mobile navigation panel -->
      <nav
        id="mobile-nav"
        class="md:hidden hidden border-t border-slate-200 bg-white"
        aria-label="Principal"
      >
        <ul class="max-w-5xl mx-auto px-4 py-3 flex flex-col">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="mobile-nav-link block rounded-lg px-3 py-3 text-base font-medium text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 transition"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <script>
      const toggle = document.getElementById('nav-toggle');
      const panel = document.getElementById('mobile-nav');
      const iconOpen = document.getElementById('nav-icon-open');
      const iconClose = document.getElementById('nav-icon-close');

      if (toggle && panel && iconOpen && iconClose) {
        const setOpen = (open: boolean) => {
          panel.classList.toggle('hidden', !open);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
          iconOpen.classList.toggle('hidden', open);
          iconClose.classList.toggle('hidden', !open);
        };

        toggle.addEventListener('click', () => {
          setOpen(panel.classList.contains('hidden'));
        });

        panel.querySelectorAll('.mobile-nav-link').forEach((link) => {
          link.addEventListener('click', () => setOpen(false));
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setOpen(false);
        });
      }
    </script>

    <!-- Optional full-bleed hero (e.g. home page) -->
    <slot name="hero" />

    <!-- Main Content Container -->
    <main class="flex-grow max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 mt-auto py-8">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
        <p>&copy; {new Date().getFullYear()} Porto Não-Monogâmico. Um espaço de diálogo e partilha comunitária.</p>
        <a
          href="/admin/"
          class="text-slate-400 hover:text-indigo-600 transition underline-offset-2 hover:underline"
        >
          Área de gestão
        </a>
      </div>
    </footer>

  </body>
</html>