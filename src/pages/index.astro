---
// File: src/pages/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Fetch events and articles
const allEvents = await getCollection('events');
const allArticles = await getCollection('articles');

// Sort events chronologically
const sortedEvents = allEvents.sort(
  (a, b) => new Date(a.data.eventDate).getTime() - new Date(b.data.eventDate).getTime()
);

// Identify upcoming event (or show the most recent one if no future dates exist yet)
const now = new Date();
const upcomingEvents = sortedEvents.filter((e) => new Date(e.data.eventDate) >= now);
const nextEvent = upcomingEvents[0] || sortedEvents[sortedEvents.length - 1];

// Get 3 most recent articles
const recentArticles = allArticles
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<BaseLayout title="Início">
  <!-- Netlify Identity widget script for contributor invites -->
  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script is:inline>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", (user) => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>

  <!-- 1. HERO SECTION -->
  <section class="text-center py-10 md:py-14">
    <span class="inline-block bg-indigo-50 text-indigo-700 font-semibold text-xs px-3 py-1 rounded-full uppercase tracking-wider mb-4">
      Comunidade no Porto
    </span>
    <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
      Tertúlias Não Mónó
    </h1>
    <p class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto mt-4 leading-relaxed">
      Um espaço seguro de partilha, diálogo e comunidade sobre não-monogamias éticas.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a 
        href="#proximo-encontro" 
        class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-6 py-3 rounded-xl shadow-sm hover:shadow transition"
      >
        📅 Próximos Eventos
      </a>
      <a 
        href="#whatsapp" 
        class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-6 py-3 rounded-xl shadow-sm hover:shadow transition"
      >
        💬 Comunidade WhatsApp
      </a>
    </div>
  </section>

  <!-- 2. SPOTLIGHT: NEXT EVENT -->
  <section id="proximo-encontro" class="scroll-mt-20 my-8">
    <div class="bg-gradient-to-br from-indigo-900 to-slate-900 text-white rounded-2xl p-8 md:p-10 shadow-xl relative overflow-hidden">
      <div class="flex items-center gap-2 text-indigo-300 font-semibold text-xs uppercase tracking-wider mb-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
        Destaque / Próxima Tertúlia
      </div>

      {nextEvent ? (
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mt-4">
          <div class="max-w-2xl">
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-3 leading-snug">
              {nextEvent.data.title}
            </h2>
            <div class="flex flex-wrap gap-4 text-sm text-slate-300">
              <span class="flex items-center gap-1.5">
                📅 {new Date(nextEvent.data.eventDate).toLocaleDateString('pt-PT', { day: 'numeric', month: 'long', year: 'numeric' })}
              </span>
              <span class="flex items-center gap-1.5">
                📍 {nextEvent.data.location}
              </span>
            </div>
          </div>

          <a 
            href="/events" 
            class="inline-flex items-center justify-center bg-white text-indigo-900 hover:bg-indigo-50 font-bold px-5 py-2.5 rounded-lg text-sm transition shrink-0"
          >
            Ver Todos os Eventos →
          </a>
        </div>
      ) : (
        <p class="text-slate-300">Sem eventos agendados no momento.</p>
      )}
    </div>
  </section>

  <!-- 3. COMMUNITY VALUES & SAFE SPACE -->
  <section class="my-16 grid md:grid-cols-3 gap-6">
    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <div class="text-2xl mb-2">🤝</div>
      <h3 class="font-bold text-slate-900 text-lg mb-2">Espaço Seguro</h3>
      <p class="text-slate-600 text-sm leading-relaxed">
        Encontros baseados no respeito mútuo, confidencialidade e acolhimento livre de julgamentos.
      </p>
    </div>

    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <div class="text-2xl mb-2">💬</div>
      <h3 class="font-bold text-slate-900 text-lg mb-2">Diálogo Aberto</h3>
      <p class="text-slate-600 text-sm leading-relaxed">
        Conversas horizontais sobre afetos, limites, ética e relações não-monogâmicas.
      </p>
    </div>

    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm">
      <div class="text-2xl mb-2">🌱</div>
      <h3 class="font-bold text-slate-900 text-lg mb-2">Rede Comunitária</h3>
      <p class="text-slate-600 text-sm leading-relaxed">
        Uma rede viva de partilha, apoio mútuo, eventos e profissionais afirmativos no Porto.
      </p>
    </div>
  </section>

  <!-- 4. WHATSAPP HUB -->
  <section id="whatsapp" class="scroll-mt-20 my-16 bg-emerald-50 border border-emerald-200 rounded-2xl p-8 md:p-10 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="max-w-xl">
      <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider">Grupo de Conversa</span>
      <h2 class="text-2xl font-bold text-slate-900 mt-1 mb-2">Junta-te à Comunidade no WhatsApp</h2>
      <p class="text-slate-600 text-sm leading-relaxed">
        Temos vários grupos temáticos para partilha diária, apoio comunitário e organização dos nossos encontros presenciais.
      </p>
    </div>

    <!-- Update href below with your actual WhatsApp invite link when ready -->
    <a 
      href="https://chat.whatsapp.com/" 
      target="_blank" 
      rel="noopener noreferrer"
      class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-6 py-3 rounded-xl shadow-sm transition shrink-0"
    >
      Entrar no WhatsApp →
    </a>
  </section>

  <!-- 5. RECENT ARTICLES TEASER -->
  <section class="my-16">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">Leituras Recentes</h2>
        <p class="text-slate-500 text-sm">Reflexões e artigos partilhados pela comunidade.</p>
      </div>
      <a href="/articles" class="text-sm font-semibold text-indigo-600 hover:text-indigo-800 transition">
        Ver todos →
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {recentArticles.map((article) => (
        <a 
          href={`/articles/${article.id}`} 
          class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm hover:shadow-md hover:border-indigo-300 transition flex flex-col justify-between"
        >
          <div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-600">Artigo</span>
            <h3 class="font-bold text-slate-900 mt-1 mb-2 leading-snug">{article.data.title}</h3>
          </div>
          <div class="text-xs text-slate-400 mt-4">
            Por {article.data.author}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>