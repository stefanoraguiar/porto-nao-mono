---
// File: src/pages/index.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Fetch events and articles
const allEvents = await getCollection('events');
const allArticles = await getCollection('articles');

// Sort events chronologically
const sortedEvents = allEvents.sort(
  (a, b) => new Date(a.data.eventDate).getTime() - new Date(b.data.eventDate).getTime()
);

const now = new Date();
const upcomingEvents = sortedEvents.filter((e) => new Date(e.data.eventDate) >= now);
const nextEvent = upcomingEvents[0] || sortedEvents[sortedEvents.length - 1];

// Get 3 most recent articles
const recentArticles = allArticles
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

// Stock community imagery placeholders (Replace with your actual photos in /public/ images later)
const heroImage = "https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=1200&q=80";
const articleFallbackImages = [
  "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=600&q=80",
  "https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=600&q=80",
  "https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=600&q=80"
];
---

<BaseLayout title="Início">
  <!-- Netlify Identity widget script for contributor invites -->
  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script is:inline>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", (user) => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>

  <!-- TOP DECORATIVE RAINBOW BAR -->
  <div class="h-1.5 w-full bg-gradient-to-r from-rose-500 via-amber-400 via-emerald-400 via-sky-400 to-purple-600 rounded-full mb-8"></div>

  <!-- 1. HERO SECTION WITH IMAGE -->
  <section class="grid lg:grid-cols-12 gap-8 items-center py-6 md:py-10">
    <div class="lg:col-span-7 space-y-5">
      <div class="inline-flex items-center gap-2 bg-gradient-to-r from-rose-50 via-purple-50 to-indigo-50 border border-rose-200 text-rose-800 text-xs font-bold px-3 py-1.5 rounded-full shadow-sm">
        <span>🌈</span>
        <span>Espaço Aberto, Queer & LGBTQIA+ Friendly</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 leading-[1.1]">
        Tertúlias <br />
        <span class="bg-gradient-to-r from-rose-600 via-purple-600 to-indigo-600 bg-clip-text text-transparent">
          Não Mónó
        </span>
      </h1>

      <p class="text-lg text-slate-700 leading-relaxed max-w-xl">
        Um espaço seguro, comunitário e acolhedor de partilha, diálogo e afetos sobre não-monogamias éticas no Porto.
      </p>

      <div class="pt-2 flex flex-wrap gap-4">
        <a 
          href="#proximo-encontro" 
          class="bg-gradient-to-r from-rose-600 to-purple-600 hover:from-rose-700 hover:to-purple-700 text-white font-bold px-6 py-3.5 rounded-xl shadow-md hover:shadow-lg transition transform hover:-translate-y-0.5"
        >
          📅 Próximos Eventos
        </a>
        <a 
          href="#whatsapp" 
          class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-6 py-3.5 rounded-xl shadow-md hover:shadow-lg transition transform hover:-translate-y-0.5"
        >
          💬 Entrar no WhatsApp
        </a>
      </div>
    </div>

    <!-- HERO IMAGE -->
    <div class="lg:col-span-5 relative">
      <div class="absolute -inset-2 bg-gradient-to-r from-rose-400 via-purple-400 to-amber-300 rounded-3xl blur-xl opacity-30"></div>
      <div class="relative rounded-2xl overflow-hidden shadow-2xl border-4 border-white aspect-[4/3] sm:aspect-[16/10] lg:aspect-[4/3]">
        <img 
          src={heroImage} 
          alt="Comunidade Tertúlias Não Mónó reunida em convívio" 
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/40 via-transparent to-transparent"></div>
        <span class="absolute bottom-3 left-3 text-white text-xs font-semibold bg-slate-900/60 backdrop-blur-sm px-3 py-1 rounded-full">
          ✨ Encontros Presenciais no Porto
        </span>
      </div>
    </div>
  </section>

  <!-- 2. SPOTLIGHT: NEXT EVENT (COLORFUL GRADIENT CARD) -->
  <section id="proximo-encontro" class="scroll-mt-20 my-12">
    <div class="relative bg-gradient-to-br from-purple-900 via-indigo-900 to-rose-950 text-white rounded-3xl p-8 md:p-12 shadow-2xl overflow-hidden border border-purple-500/20">
      
      <!-- Background Glow Effect -->
      <div class="absolute -top-24 -right-24 w-72 h-72 bg-rose-500/30 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-purple-500/30 rounded-full blur-3xl"></div>

      <div class="relative z-10">
        <div class="inline-flex items-center gap-2 bg-rose-500/20 text-rose-200 border border-rose-400/30 font-bold text-xs px-3 py-1 rounded-full uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-rose-400 animate-ping"></span>
          Destaque / Próxima Tertúlia
        </div>

        {nextEvent ? (
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
            <div class="space-y-3 max-w-2xl">
              <h2 class="text-3xl sm:text-4xl font-extrabold text-white leading-snug">
                {nextEvent.data.title}
              </h2>
              <div class="flex flex-wrap gap-4 text-sm text-purple-100 pt-1">
                <span class="bg-white/10 backdrop-blur-md px-3 py-1.5 rounded-lg border border-white/10 flex items-center gap-2">
                  📅 <strong>{new Date(nextEvent.data.eventDate).toLocaleDateString('pt-PT', { day: 'numeric', month: 'long', year: 'numeric' })}</strong>
                </span>
                <span class="bg-white/10 backdrop-blur-md px-3 py-1.5 rounded-lg border border-white/10 flex items-center gap-2">
                  📍 <strong>{nextEvent.data.location}</strong>
                </span>
              </div>
            </div>

            <a 
              href="/events" 
              class="inline-flex items-center justify-center bg-white text-purple-950 hover:bg-rose-50 font-extrabold px-6 py-4 rounded-xl shadow-lg transition shrink-0 transform hover:scale-105"
            >
              Ver Agenda Completa →
            </a>
          </div>
        ) : (
          <p class="text-purple-200">Sem novos eventos agendados de momento.</p>
        )}
      </div>
    </div>
  </section>

  <!-- 3. INCLUSIVE VALUES (COLORFUL CARDS) -->
  <section class="my-16">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-3xl font-extrabold text-slate-900">Como Funcionam Nossos Encontros</h2>
      <p class="text-slate-600 mt-2">Um espaço seguro e inclusivo construído coletivamente.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-rose-50/60 border border-rose-200 p-7 rounded-2xl shadow-sm hover:shadow-md transition">
        <div class="w-12 h-12 bg-rose-500 text-white rounded-xl flex items-center justify-center text-2xl shadow-md mb-4">
          🫂
        </div>
        <h3 class="font-bold text-slate-900 text-xl mb-2">Acolhimento & Afeto</h3>
        <p class="text-slate-700 text-sm leading-relaxed">
          Encontros presenciais onde cada vivência é respeitada, validada e acolhida sem pré-julgamentos.
        </p>
      </div>

      <div class="bg-purple-50/60 border border-purple-200 p-7 rounded-2xl shadow-sm hover:shadow-md transition">
        <div class="w-12 h-12 bg-purple-600 text-white rounded-xl flex items-center justify-center text-2xl shadow-md mb-4">
          🌈
        </div>
        <h3 class="font-bold text-slate-900 text-xl mb-2">Diversidade e Inclusão</h3>
        <p class="text-slate-700 text-sm leading-relaxed">
          Aberto a todas as identidades de género, orientações afetivo-sexuais e estruturas de relacionamento não-monogâmicas.
        </p>
      </div>

      <div class="bg-amber-50/60 border border-amber-200 p-7 rounded-2xl shadow-sm hover:shadow-md transition">
        <div class="w-12 h-12 bg-amber-500 text-white rounded-xl flex items-center justify-center text-2xl shadow-md mb-4">
          🛡️
        </div>
        <h3 class="font-bold text-slate-900 text-xl mb-2">Consentimento e Limites</h3>
        <p class="text-slate-700 text-sm leading-relaxed">
          Priorizamos o consentimento entusiasmado, a confidencialidade e o respeito rigoroso pelos limites individuais.
        </p>
      </div>
    </div>
  </section>

  <!-- 4. WHATSAPP HUB (EMERALD VIBRANT BOX) -->
  <section id="whatsapp" class="scroll-mt-20 my-16 bg-gradient-to-r from-emerald-600 to-teal-700 text-white rounded-3xl p-8 md:p-10 shadow-xl flex flex-col lg:flex-row items-center justify-between gap-8">
    <div class="space-y-2 max-w-xl text-center lg:text-left">
      <span class="inline-block bg-emerald-900/40 text-emerald-100 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
        Comunidade Ativa
      </span>
      <h2 class="text-3xl font-extrabold text-white">Junta-te à Nossa Rede no WhatsApp</h2>
      <p class="text-emerald-100 text-sm leading-relaxed">
        Temos vários sub-grupos temáticos para partilhas diárias, tiragem de dúvidas, apoio mútuo e organização das tertúlias no Porto.
      </p>
    </div>

    <a 
      href="https://chat.whatsapp.com/" 
      target="_blank" 
      rel="noopener noreferrer"
      class="bg-white text-emerald-900 hover:bg-emerald-50 font-extrabold px-8 py-4 rounded-xl shadow-lg transition shrink-0 transform hover:scale-105"
    >
      💬 Entrar no Grupo WhatsApp
    </a>
  </section>

<!-- 5. RECENT ARTICLES WITH REAL SANITY IMAGES -->
  <section class="my-16">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-3xl font-extrabold text-slate-900">Artigos e Reflexões</h2>
        <p class="text-slate-600 text-sm mt-1">Textos produzidos e partilhados pela nossa comunidade.</p>
      </div>
      <a href="/articles" class="text-sm font-bold text-purple-600 hover:text-purple-800 transition">
        Ver todos →
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {recentArticles.map((article, idx) => {
        const coverImg = article.data.image || articleFallbackImages[idx % articleFallbackImages.length];
        return (
          <a 
            href={`/articles/${article.id}`} 
            class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-xl hover:border-purple-300 transition overflow-hidden group flex flex-col justify-between"
          >
            <div>
              <div class="h-48 overflow-hidden relative bg-slate-100">
                <img 
                  src={coverImg} 
                  alt={article.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                />
                <span class="absolute top-3 left-3 bg-purple-600 text-white text-[10px] font-bold px-2.5 py-1 rounded-md shadow">
                  Artigo
                </span>
              </div>

              <div class="p-5">
                <h3 class="font-bold text-slate-900 text-lg group-hover:text-purple-600 transition leading-snug">
                  {article.data.title}
                </h3>
              </div>
            </div>

            <div class="px-5 pb-5 pt-0 text-xs text-slate-500 font-medium">
              ✍️ Por {article.data.author}
            </div>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>