---
// File: src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Início">
  <h1>Bem-vindo às Tertúlias Não Mónó</h1>
  <p>Um espaço comunitário para partilha de artigos, eventos e rede de profissionais.</p>

  <!-- Netlify Identity widget script for handling contributor email invites -->
  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script is:inline>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", (user) => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</BaseLayout>