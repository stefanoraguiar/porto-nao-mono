---
// File: src/pages/gallery.astro
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allGalleries = await getCollection('galleries');

// Sort albums newest first
const sortedGalleries = allGalleries.sort(
  (a, b) => new Date(b.data.eventDate).getTime() - new Date(a.data.eventDate).getTime()
);
---

<BaseLayout title="Galeria de Fotos">
  <div class="mb-10 text-center max-w-2xl mx-auto">
    <span class="inline-block bg-purple-100 text-purple-800 font-bold text-xs px-3 py-1 rounded-full uppercase tracking-wider mb-3">
      📸 Memórias Comunitárias
    </span>
    <h1 class="text-4xl font-extrabold text-slate-900 tracking-tight">Galeria de Fotografias</h1>
    <p class="text-slate-600 mt-2">
      Momentos, encontros e tertúlias registadas ao longo do tempo.
    </p>
  </div>

  {sortedGalleries.length === 0 ? (
    <div class="text-center py-12 bg-white rounded-2xl border border-slate-200">
      <p class="text-slate-500">Nenhum álbum de fotografias encontrado.</p>
    </div>
  ) : (
    <div class="space-y-14">
      {sortedGalleries.map((album) => (
        <section class="space-y-4">
          <!-- DATE & EVENT HEADER (Google Photos Style) -->
          <div class="sticky top-16 z-30 bg-slate-50/95 backdrop-blur-md py-3 border-b border-slate-200 flex flex-wrap items-baseline justify-between gap-2">
            <div>
              <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
                <span>{album.data.title}</span>
              </h2>
              <p class="text-xs text-slate-500 flex items-center gap-2 mt-0.5">
                📍 {album.data.location}
              </p>
            </div>
            <span class="text-xs font-bold bg-purple-50 text-purple-700 px-3 py-1 rounded-lg border border-purple-200">
              📅 {new Date(album.data.eventDate).toLocaleDateString('pt-PT', { day: 'numeric', month: 'long', year: 'numeric' })}
            </span>
          </div>

          <!-- PHOTO GRID -->
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 sm:gap-4">
            {album.data.photos.map((photo, index) => (
              <div 
                class="group relative aspect-square bg-slate-200 rounded-xl overflow-hidden cursor-pointer shadow-sm hover:shadow-md transition"
                onclick={`openLightbox('${photo.url}', '${photo.caption.replace(/'/g, "\\'")}')`}
              >
                <img 
                  src={photo.url} 
                  alt={photo.caption || album.data.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                />
                
                <!-- Hover Overlay -->
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-3">
                  <p class="text-white text-xs font-medium line-clamp-2">
                    {photo.caption || "Ver foto"}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  )}

  <!-- LIGHTBOX MODAL -->
  <div 
    id="lightbox" 
    class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md hidden flex flex-col items-center justify-between p-4 md:p-8"
    onclick="closeLightbox()"
  >
    <!-- Close Button -->
    <div class="w-full flex justify-end">
      <button 
        class="text-white bg-white/10 hover:bg-white/20 px-4 py-2 rounded-lg text-sm font-bold transition"
        onclick="closeLightbox()"
      >
        ✕ Fechar (Esc)
      </button>
    </div>

    <!-- Image Container -->
    <div class="my-auto max-w-5xl max-h-[80vh] flex flex-col items-center" onclick="event.stopPropagation()">
      <img id="lightbox-img" src="" alt="" class="max-h-[75vh] w-auto object-contain rounded-lg shadow-2xl" />
      <p id="lightbox-caption" class="text-white/90 text-sm mt-4 text-center font-medium bg-slate-900/60 px-4 py-2 rounded-lg"></p>
    </div>

    <div></div>
  </div>
</BaseLayout>

<script is:inline>
  function openLightbox(url, caption) {
    const lightbox = document.getElementById('lightbox');
    const img = document.getElementById('lightbox-img');
    const captionEl = document.getElementById('lightbox-caption');
    
    img.src = url;
    captionEl.textContent = caption || '';
    lightbox.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    const lightbox = document.getElementById('lightbox');
    lightbox.classList.add('hidden');
    document.body.style.overflow = 'auto';
  }

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>