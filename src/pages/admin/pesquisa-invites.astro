---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Convites da pesquisa" noindex={true}>
  <div class="mb-8 max-w-2xl">
    <p class="text-xs font-semibold uppercase tracking-wide text-indigo-600 mb-2">Administração</p>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
      Convites da pesquisa
    </h1>
    <p class="text-slate-600 mt-2 leading-relaxed">
      Gera códigos de uso único. São mostrados uma vez — copia-os e partilha-os em privado.
      O servidor guarda apenas hashes; não associes códigos a nomes nesta página nem noutro sítio.
    </p>
  </div>

  <div class="max-w-xl space-y-6" id="invite-admin">
    <form id="invite-form" class="space-y-4 rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-sm">
      <label class="block space-y-2">
        <span class="text-sm font-semibold text-slate-800">Palavra-passe de administração</span>
        <input
          type="password"
          id="admin-secret"
          autocomplete="current-password"
          class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
        />
      </label>
      <label class="block space-y-2">
        <span class="text-sm font-semibold text-slate-800">Quantidade</span>
        <input
          type="number"
          id="invite-count"
          min="1"
          max="50"
          value="5"
          class="w-full rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
        />
      </label>
      <button
        type="submit"
        id="btn-generate"
        class="inline-flex items-center justify-center rounded-xl bg-indigo-700 hover:bg-indigo-800 text-white text-sm font-bold px-5 py-2.5 shadow-sm transition"
      >
        Gerar códigos
      </button>
      <p id="admin-error" class="hidden text-sm text-rose-700"></p>
    </form>

    <div id="codes-panel" class="hidden space-y-3 rounded-2xl border border-amber-200 bg-amber-50 p-5 sm:p-6">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="text-lg font-bold text-amber-950">Códigos gerados</h2>
          <p class="text-sm text-amber-900/80 mt-1">
            Guarda esta lista agora. Depois de saíres desta página, não voltamos a mostrá-la.
          </p>
        </div>
        <button
          type="button"
          id="btn-copy"
          class="shrink-0 inline-flex items-center justify-center rounded-xl border border-amber-300 bg-white hover:bg-amber-100 text-amber-950 text-sm font-semibold px-4 py-2 transition"
        >
          Copiar lista
        </button>
      </div>
      <pre
        id="codes-list"
        class="overflow-x-auto rounded-xl bg-white/80 border border-amber-200 px-4 py-3 text-sm font-mono text-slate-900 leading-relaxed"
      ></pre>
      <p id="copy-feedback" class="hidden text-xs font-medium text-emerald-800">Lista copiada.</p>
      <p class="text-xs text-amber-900/70 leading-relaxed">
        Ligação para participantes:
        <code class="font-mono bg-white/60 px-1 rounded">/pesquisa</code>
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('invite-form') as HTMLFormElement | null;
  if (form) {
    const errorEl = document.getElementById('admin-error')!;
    const codesPanel = document.getElementById('codes-panel')!;
    const codesList = document.getElementById('codes-list')!;
    const copyFeedback = document.getElementById('copy-feedback')!;
    const btnGenerate = document.getElementById('btn-generate') as HTMLButtonElement;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorEl.classList.add('hidden');
      codesPanel.classList.add('hidden');
      copyFeedback.classList.add('hidden');

      const secret = (document.getElementById('admin-secret') as HTMLInputElement).value;
      const count = Number((document.getElementById('invite-count') as HTMLInputElement).value) || 1;

      btnGenerate.disabled = true;
      btnGenerate.textContent = 'A gerar…';

      try {
        const res = await fetch('/.netlify/functions/pesquisa-admin-invites', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ secret, count, website_url: '' }),
        });
        const data = await res.json().catch(() => ({}));

        if (!res.ok || !data.ok) {
          errorEl.textContent =
            res.status === 401
              ? 'Palavra-passe incorrecta.'
              : data.error || 'Não foi possível gerar códigos.';
          errorEl.classList.remove('hidden');
          return;
        }

        const codes: string[] = data.codes || [];
        codesList.textContent = codes.join('\n');
        codesPanel.classList.remove('hidden');
      } catch {
        errorEl.textContent = 'Erro de rede. Tenta de novo.';
        errorEl.classList.remove('hidden');
      } finally {
        btnGenerate.disabled = false;
        btnGenerate.textContent = 'Gerar códigos';
      }
    });

    document.getElementById('btn-copy')!.addEventListener('click', async () => {
      const text = codesList.textContent || '';
      try {
        await navigator.clipboard.writeText(text);
        copyFeedback.classList.remove('hidden');
      } catch {
        copyFeedback.textContent = 'Selecciona e copia manualmente.';
        copyFeedback.classList.remove('hidden');
      }
    });
  }
</script>
