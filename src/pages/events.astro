---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allEvents = await getCollection('events');
---

<BaseLayout title="Eventos">
  <div class="mb-8">
    <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Eventos</h1>
    <p class="text-slate-600 mt-1">Histórico e agendamento dos nossos encontros e tertúlias.</p>
  </div>

  {allEvents.length === 0 ? (
    <p class="text-slate-500 italic">Nenhum evento agendado.</p>
  ) : (
    <div class="space-y-4">
      {allEvents.map((event) => (
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <h2 class="text-xl font-bold text-slate-900">{event.data.title}</h2>
            <p class="text-sm text-slate-500 mt-1">📍 {event.data.location}</p>
          </div>
          <div class="shrink-0 bg-slate-100 px-4 py-2 rounded-lg text-center text-xs font-bold text-slate-700">
            📅 {event.data.eventDate.toLocaleDateString('pt-PT')}
          </div>
        </div>
      ))}
    </div>
  )}
</BaseLayout>