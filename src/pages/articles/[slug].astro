---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, author, date, image } = article.data;
---

<BaseLayout title={title}>
  <div class="max-w-3xl mx-auto">
    <a
      href="/articles"
      class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 hover:text-purple-700 transition mb-8"
    >
      <span aria-hidden="true">←</span>
      Voltar aos artigos
    </a>

    <article>
      {image && (
        <div class="mb-8 overflow-hidden rounded-2xl bg-slate-100 shadow-sm aspect-[16/9]">
          <img
            src={image}
            alt=""
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
      )}

      <header class="mb-8 pb-8 border-b border-slate-200">
        <p class="text-xs font-bold uppercase tracking-wider text-purple-600 mb-3">Artigo</p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
          {title}
        </h1>
        <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-500">
          <span>Por <span class="font-medium text-slate-700">{author}</span></span>
          <span aria-hidden="true">·</span>
          <time datetime={date.toISOString()}>
            {date.toLocaleDateString('pt-PT', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })}
          </time>
        </div>
      </header>

      <div class="article-body">
        <Content />
      </div>

      <footer class="mt-12 pt-8 border-t border-slate-200">
        <a
          href="/articles"
          class="inline-flex items-center justify-center bg-gradient-to-r from-rose-600 to-purple-600 hover:from-rose-700 hover:to-purple-700 text-white font-bold px-5 py-3 rounded-xl shadow-md transition"
        >
          Ver mais artigos
        </a>
      </footer>
    </article>
  </div>
</BaseLayout>

<style>
  .article-body {
    color: #334155;
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .article-body :global(p) {
    margin: 0 0 1.25em;
  }

  .article-body :global(h2) {
    margin: 2em 0 0.75em;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #0f172a;
    line-height: 1.25;
  }

  .article-body :global(h3) {
    margin: 1.75em 0 0.6em;
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.3;
  }

  .article-body :global(a) {
    color: #7c3aed;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-body :global(a:hover) {
    color: #6d28d9;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1.25em;
    padding-left: 1.4em;
  }

  .article-body :global(li) {
    margin-bottom: 0.4em;
  }

  .article-body :global(blockquote) {
    margin: 1.5em 0;
    padding: 0.75em 1em;
    border-left: 4px solid #c4b5fd;
    background: #faf5ff;
    color: #475569;
    border-radius: 0 0.75rem 0.75rem 0;
  }

  .article-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .article-body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.75em 0;
    border-radius: 1rem;
  }

  .article-body :global(hr) {
    margin: 2em 0;
    border: 0;
    border-top: 1px solid #e2e8f0;
  }

  .article-body :global(strong) {
    color: #0f172a;
    font-weight: 700;
  }

  .article-body :global(em) {
    font-style: italic;
  }
</style>
