---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWebmasterEmails } from '../../data/webmasters';

const webmasterEmails = getWebmasterEmails().join(', ');

function toDateKey(date: Date) {
  return date.toLocaleDateString('en-CA', { timeZone: 'Europe/Lisbon' });
}

const allEvents = (await getCollection('events'))
  .filter((event) => event.data.approved !== false)
  .sort((a, b) => b.data.eventDate.getTime() - a.data.eventDate.getTime());

const allTags = [
  ...new Set(allEvents.flatMap((event) => event.data.tags ?? [])),
].sort((a, b) => a.localeCompare(b, 'pt'));

const eventsPayload = allEvents.map((event) => ({
  id: event.id,
  title: event.data.title,
  location: event.data.location,
  tags: event.data.tags ?? [],
  external: event.data.external ?? false,
  dateKey: toDateKey(event.data.eventDate),
  dateLabel: event.data.eventDate.toLocaleDateString('pt-PT', {
    timeZone: 'Europe/Lisbon',
    weekday: 'short',
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }),
  timeLabel: event.data.eventDate.toLocaleTimeString('pt-PT', {
    timeZone: 'Europe/Lisbon',
    hour: '2-digit',
    minute: '2-digit',
  }),
  searchText: [
    event.data.title,
    event.data.location,
    ...(event.data.tags ?? []),
    event.data.external ? 'evento externo' : '',
  ]
    .join(' ')
    .normalize('NFD')
    .replace(/\p{M}/gu, '')
    .toLocaleLowerCase('pt'),
}));

const eventDates = [...new Set(eventsPayload.map((e) => e.dateKey))];
---

<BaseLayout title="Eventos">
  <div class="flex flex-col lg:grid lg:grid-cols-[minmax(0,1fr)_15.5rem] lg:gap-x-8 lg:gap-y-6 gap-6">
    <!-- Left: title -->
    <header class="lg:col-start-1 lg:row-start-1">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
        <div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Eventos</h1>
          <p class="text-slate-600 mt-1.5 leading-relaxed text-sm sm:text-base">
            Histórico e agendamento dos nossos encontros e tertúlias.
          </p>
        </div>
        <button
          type="button"
          id="open-suggest-event"
          class="shrink-0 inline-flex items-center justify-center bg-gradient-to-r from-rose-600 to-purple-600 hover:from-rose-700 hover:to-purple-700 text-white text-sm font-bold px-4 py-2.5 rounded-xl shadow-md transition"
        >
          Sugerir evento
        </button>
      </div>
    </header>

    <!-- Right: calendar, search, filters -->
    <aside class="lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:sticky lg:top-20 space-y-4 self-start">
      <div
        id="event-calendar"
        class="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm"
        data-event-dates={JSON.stringify(eventDates)}
        aria-label="Calendário de eventos"
      >
        <div class="flex items-center justify-between mb-2">
          <button
            type="button"
            id="cal-prev"
            class="h-8 w-8 rounded-lg text-slate-500 hover:bg-slate-100 hover:text-slate-800 transition"
            aria-label="Mês anterior"
          >
            ‹
          </button>
          <p id="cal-month-label" class="text-sm font-bold text-slate-800 capitalize"></p>
          <button
            type="button"
            id="cal-next"
            class="h-8 w-8 rounded-lg text-slate-500 hover:bg-slate-100 hover:text-slate-800 transition"
            aria-label="Mês seguinte"
          >
            ›
          </button>
        </div>
        <div class="grid grid-cols-7 gap-0.5 text-center text-[10px] font-semibold uppercase tracking-wide text-slate-400 mb-1">
          <span>Seg</span><span>Ter</span><span>Qua</span><span>Qui</span><span>Sex</span><span>Sáb</span><span>Dom</span>
        </div>
        <div id="cal-grid" class="grid grid-cols-7 gap-0.5"></div>
        <button
          type="button"
          id="cal-clear"
          class="mt-2 hidden w-full text-xs font-medium text-purple-600 hover:text-purple-800 transition"
        >
          Limpar data selecionada
        </button>
      </div>

      {allEvents.length > 0 && (
        <>
          <div>
            <label for="event-search" class="sr-only">Pesquisar eventos</label>
            <div class="relative">
              <svg
                class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-slate-400"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35m1.6-5.4a7 7 0 1 1-14 0 7 7 0 0 1 14 0Z" />
              </svg>
              <input
                id="event-search"
                type="search"
                placeholder="Pesquisar por nome…"
                autocomplete="off"
                class="w-full rounded-xl border border-slate-200 bg-white py-2.5 pl-9 pr-3 text-sm text-slate-800 placeholder:text-slate-400 shadow-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-200 transition"
              />
            </div>
          </div>

          {allTags.length > 0 && (
            <div class="flex flex-wrap gap-1.5" id="event-tag-filters" role="group" aria-label="Filtrar por etiqueta">
              <button
                type="button"
                data-tag=""
                class="event-tag-btn is-active rounded-full border px-2.5 py-1 text-[11px] font-semibold transition border-purple-600 bg-purple-600 text-white"
              >
                Todas
              </button>
              {allTags.map((tag) => (
                <button
                  type="button"
                  data-tag={tag}
                  class="event-tag-btn rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-600 hover:border-purple-300 hover:text-purple-700 transition"
                >
                  {tag}
                </button>
              ))}
            </div>
          )}

          <p class="rounded-xl border border-amber-200 bg-amber-50 px-3 py-2.5 text-[11px] leading-relaxed text-amber-950/80">
            <span class="font-bold text-amber-800">Evento Externo</span>
            — partilhado por relevância, mas não organizado pela comunidade Porto Não-Monogâmico.
          </p>
        </>
      )}
    </aside>

    <!-- Left: event list -->
    <div class="lg:col-start-1 lg:row-start-2 min-w-0">
      {allEvents.length === 0 ? (
        <p class="text-slate-500 italic">Nenhum evento agendado.</p>
      ) : (
        <>
          <p id="event-filter-status" class="mb-3 text-xs text-slate-500" aria-live="polite"></p>

          <ul id="event-list" class="space-y-3">
            {eventsPayload.map((event) => (
              <li
                data-search={event.searchText}
                data-date={event.dateKey}
                data-tags={(event.tags ?? []).join('|')}
              >
                <a
                  href={`/events/${event.id}`}
                  class:list={[
                    'relative block p-4 sm:p-5 rounded-xl border shadow-sm hover:shadow-md transition group overflow-hidden',
                    event.external
                      ? 'bg-amber-50/80 border-amber-300 hover:border-amber-400'
                      : 'bg-white border-slate-200 hover:border-purple-300',
                  ]}
                >
                  {event.external && (
                    <span class="absolute top-0 right-0 rounded-bl-xl bg-amber-500 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-white shadow-sm">
                      Evento Externo
                    </span>
                  )}
                  <article class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <div class:list={['min-w-0 space-y-1.5', event.external && 'pr-24']}>
                      <h2
                        class:list={[
                          'text-lg font-bold leading-snug transition',
                          event.external
                            ? 'text-amber-950 group-hover:text-amber-800'
                            : 'text-slate-900 group-hover:text-purple-700',
                        ]}
                      >
                        {event.title}
                      </h2>
                      <p class:list={['text-sm', event.external ? 'text-amber-900/70' : 'text-slate-500']}>
                        {event.location}
                      </p>
                      {(event.tags?.length ?? 0) > 0 && (
                        <div class="flex flex-wrap gap-1.5 pt-0.5">
                          {event.tags.map((tag) => (
                            <span
                              class:list={[
                                'rounded-full border px-2 py-0.5 text-[11px] font-semibold',
                                event.external
                                  ? 'bg-amber-100 text-amber-900 border-amber-200'
                                  : 'bg-purple-50 text-purple-700 border-purple-100',
                              ]}
                            >
                              {tag}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>
                    <div
                      class:list={[
                        'shrink-0 px-3 py-2 rounded-lg text-center',
                        event.external ? 'bg-amber-100/80' : 'bg-slate-100',
                      ]}
                    >
                      <p
                        class:list={[
                          'text-xs font-bold capitalize',
                          event.external ? 'text-amber-950' : 'text-slate-700',
                        ]}
                      >
                        {event.dateLabel}
                      </p>
                      <p
                        class:list={[
                          'text-[11px] mt-0.5',
                          event.external ? 'text-amber-800/80' : 'text-slate-500',
                        ]}
                      >
                        {event.timeLabel}
                      </p>
                    </div>
                  </article>
                </a>
              </li>
            ))}
          </ul>

          <p id="event-filter-empty" class="hidden py-10 text-center text-sm text-slate-500 italic">
            Nenhum evento corresponde aos filtros selecionados.
          </p>
        </>
      )}
    </div>
  </div>

  <!-- Hidden form so Netlify detects the form at build time -->
  <form name="event-suggestion" method="POST" data-netlify="true" netlify-honeypot="website_url" class="hidden" aria-hidden="true">
    <input type="hidden" name="form-name" value="event-suggestion" />
    <input name="title" />
    <input name="eventDate" />
    <input name="location" />
    <input name="description" />
    <input name="suggestedBy" />
    <input name="suggestedEmail" />
    <input name="external" />
    <input name="website_url" />
  </form>

  <!-- Suggest event modal -->
  <div
    id="suggest-event-modal"
    class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-slate-950/60 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="suggest-event-title"
  >
    <div class="w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-2xl bg-white shadow-2xl border border-slate-200">
      <div class="sticky top-0 flex items-center justify-between gap-3 px-5 py-4 border-b border-slate-200 bg-white">
        <h2 id="suggest-event-title" class="text-lg font-extrabold text-slate-900">Sugerir evento</h2>
        <button
          type="button"
          id="close-suggest-event"
          class="h-8 w-8 rounded-lg text-slate-500 hover:bg-slate-100 hover:text-slate-800 transition"
          aria-label="Fechar"
        >
          ×
        </button>
      </div>

      <form id="suggest-event-form" class="p-5 space-y-4" data-webmaster-emails={webmasterEmails}>
        <p class="text-sm text-slate-600 leading-relaxed">
          A tua sugestão fica pendente até uma pessoa colaboradora aprovar no painel de administração.
        </p>

        <div>
          <label for="suggest-title" class="block text-xs font-bold text-slate-700 mb-1">Título do evento *</label>
          <input
            id="suggest-title"
            name="title"
            type="text"
            required
            class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-200"
          />
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="suggest-date" class="block text-xs font-bold text-slate-700 mb-1">Data e hora *</label>
            <input
              id="suggest-date"
              name="eventDate"
              type="datetime-local"
              required
              class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-200"
            />
          </div>
          <div>
            <label for="suggest-location" class="block text-xs font-bold text-slate-700 mb-1">Localização</label>
            <input
              id="suggest-location"
              name="location"
              type="text"
              placeholder="Porto / A anunciar"
              class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-200"
            />
          </div>
        </div>

        <div>
          <label for="suggest-description" class="block text-xs font-bold text-slate-700 mb-1">Descrição</label>
          <textarea
            id="suggest-description"
            name="description"
            rows="4"
            class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-200 resize-y"
          ></textarea>
        </div>

        <label class="flex items-start gap-2 text-sm text-slate-700">
          <input id="suggest-external" name="external" type="checkbox" class="mt-1 rounded border-slate-300" />
          <span>Este é um <strong>evento externo</strong> (não organizado pela comunidade).</span>
        </label>

        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="suggest-by" class="block text-xs font-bold text-slate-700 mb-1">O teu nome *</label>
            <input
              id="suggest-by"
              name="suggestedBy"
              type="text"
              required
              class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-200"
            />
          </div>
          <div>
            <label for="suggest-email" class="block text-xs font-bold text-slate-700 mb-1">O teu e-mail *</label>
            <input
              id="suggest-email"
              name="suggestedEmail"
              type="email"
              required
              class="w-full rounded-xl border border-slate-200 px-3 py-2.5 text-sm outline-none focus:border-purple-400 focus:ring-2 focus:ring-purple-200"
            />
          </div>
        </div>

        <!-- Honeypot -->
        <div class="hidden" aria-hidden="true">
          <label for="suggest-website">Website</label>
          <input id="suggest-website" name="website_url" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <p id="suggest-event-status" class="hidden text-sm" role="status"></p>

        <div class="flex flex-col sm:flex-row gap-3 pt-1">
          <button
            type="submit"
            id="suggest-event-submit"
            class="inline-flex items-center justify-center bg-gradient-to-r from-rose-600 to-purple-600 hover:from-rose-700 hover:to-purple-700 text-white font-bold px-5 py-3 rounded-xl shadow-md transition"
          >
            Enviar sugestão
          </button>
          <button
            type="button"
            id="cancel-suggest-event"
            class="inline-flex items-center justify-center bg-white border border-slate-200 text-slate-700 font-bold px-5 py-3 rounded-xl hover:bg-slate-50 transition"
          >
            Cancelar
          </button>
        </div>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  const normalize = (value: string) =>
    value
      .normalize('NFD')
      .replace(/\p{M}/gu, '')
      .toLocaleLowerCase('pt');

  const calendarEl = document.getElementById('event-calendar');
  const gridEl = document.getElementById('cal-grid');
  const monthLabelEl = document.getElementById('cal-month-label');
  const prevBtn = document.getElementById('cal-prev');
  const nextBtn = document.getElementById('cal-next');
  const clearBtn = document.getElementById('cal-clear');
  const searchInput = document.getElementById('event-search') as HTMLInputElement | null;
  const listEl = document.getElementById('event-list');
  const emptyEl = document.getElementById('event-filter-empty');
  const statusEl = document.getElementById('event-filter-status');
  const tagButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.event-tag-btn'));

  if (!calendarEl || !gridEl || !monthLabelEl || !listEl) {
    // no-op when page has no events
  } else {
    const eventDates = new Set<string>(
      JSON.parse(calendarEl.dataset.eventDates || '[]') as string[]
    );
    const items = Array.from(listEl.querySelectorAll<HTMLElement>(':scope > li'));

    let viewYear: number;
    let viewMonth: number; // 0-11
    let selectedDate: string | null = null;
    let selectedTag = '';

    const todayKey = new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/Lisbon' });
    const [ty, tm] = todayKey.split('-').map(Number);
    viewYear = ty;
    viewMonth = tm - 1;

    // Prefer showing a month that has events if current month has none
    if (![...eventDates].some((d) => d.startsWith(todayKey.slice(0, 7)))) {
      const newest = [...eventDates].sort().at(-1);
      if (newest) {
        const [y, m] = newest.split('-').map(Number);
        viewYear = y;
        viewMonth = m - 1;
      }
    }

    const applyFilters = () => {
      const query = normalize(searchInput?.value.trim() ?? '');
      let visible = 0;

      for (const item of items) {
        const haystack = item.dataset.search ?? '';
        const dateKey = item.dataset.date ?? '';
        const tags = (item.dataset.tags ?? '').split('|').filter(Boolean);

        const matchesSearch = !query || haystack.includes(query);
        const matchesDate = !selectedDate || dateKey === selectedDate;
        const matchesTag = !selectedTag || tags.includes(selectedTag);
        const match = matchesSearch && matchesDate && matchesTag;

        item.hidden = !match;
        if (match) visible += 1;
      }

      if (emptyEl) emptyEl.classList.toggle('hidden', visible > 0);
      listEl.classList.toggle('hidden', visible === 0);

      if (statusEl) {
        const parts: string[] = [];
        if (query) parts.push(`pesquisa “${searchInput?.value.trim()}”`);
        if (selectedDate) {
          parts.push(
            `data ${new Date(selectedDate + 'T12:00:00').toLocaleDateString('pt-PT', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })}`
          );
        }
        if (selectedTag) parts.push(`etiqueta “${selectedTag}”`);

        if (parts.length === 0) {
          statusEl.textContent = '';
        } else {
          statusEl.textContent =
            visible === 1
              ? `1 evento · ${parts.join(' · ')}`
              : `${visible} eventos · ${parts.join(' · ')}`;
        }
      }

      if (clearBtn) clearBtn.classList.toggle('hidden', !selectedDate);
      renderCalendar();
    };

    const renderCalendar = () => {
      const first = new Date(viewYear, viewMonth, 1);
      const startOffset = (first.getDay() + 6) % 7; // Monday-first
      const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

      monthLabelEl.textContent = first.toLocaleDateString('pt-PT', {
        month: 'long',
        year: 'numeric',
      });

      gridEl.replaceChildren();

      for (let i = 0; i < startOffset; i += 1) {
        const spacer = document.createElement('span');
        spacer.className = 'h-8';
        gridEl.appendChild(spacer);
      }

      for (let day = 1; day <= daysInMonth; day += 1) {
        const dateKey = `${viewYear}-${String(viewMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const hasEvent = eventDates.has(dateKey);
        const isSelected = selectedDate === dateKey;
        const isToday = dateKey === todayKey;

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = String(day);
        btn.dataset.date = dateKey;
        btn.disabled = !hasEvent;
        btn.setAttribute('aria-label', `Dia ${day}${hasEvent ? ', com eventos' : ''}`);
        btn.className = [
          'relative h-8 rounded-lg text-xs font-medium transition',
          hasEvent
            ? 'text-slate-800 hover:bg-purple-50 cursor-pointer'
            : 'text-slate-300 cursor-default',
          isSelected ? 'bg-purple-600 text-white hover:bg-purple-600' : '',
          isToday && !isSelected ? 'ring-1 ring-purple-300' : '',
        ]
          .filter(Boolean)
          .join(' ');

        if (hasEvent) {
          const dot = document.createElement('span');
          dot.className = [
            'absolute bottom-0.5 left-1/2 -translate-x-1/2 h-1 w-1 rounded-full',
            isSelected ? 'bg-white' : 'bg-rose-500',
          ].join(' ');
          btn.appendChild(dot);
        }

        if (hasEvent) {
          btn.addEventListener('click', () => {
            selectedDate = selectedDate === dateKey ? null : dateKey;
            applyFilters();
          });
        }

        gridEl.appendChild(btn);
      }
    };

    prevBtn?.addEventListener('click', () => {
      viewMonth -= 1;
      if (viewMonth < 0) {
        viewMonth = 11;
        viewYear -= 1;
      }
      renderCalendar();
    });

    nextBtn?.addEventListener('click', () => {
      viewMonth += 1;
      if (viewMonth > 11) {
        viewMonth = 0;
        viewYear += 1;
      }
      renderCalendar();
    });

    clearBtn?.addEventListener('click', () => {
      selectedDate = null;
      applyFilters();
    });

    searchInput?.addEventListener('input', applyFilters);

    for (const btn of tagButtons) {
      btn.addEventListener('click', () => {
        selectedTag = btn.dataset.tag ?? '';
        for (const other of tagButtons) {
          const active = other === btn;
          other.classList.toggle('is-active', active);
          other.classList.toggle('border-purple-600', active);
          other.classList.toggle('bg-purple-600', active);
          other.classList.toggle('text-white', active);
          other.classList.toggle('border-slate-200', !active);
          other.classList.toggle('bg-white', !active);
          other.classList.toggle('text-slate-600', !active);
        }
        applyFilters();
      });
    }

    applyFilters();
  }

  // Suggest event modal
  const suggestModal = document.getElementById('suggest-event-modal');
  const suggestForm = document.getElementById('suggest-event-form') as HTMLFormElement | null;
  const suggestStatus = document.getElementById('suggest-event-status');
  const suggestSubmit = document.getElementById('suggest-event-submit') as HTMLButtonElement | null;
  const openSuggest = document.getElementById('open-suggest-event');
  const closeSuggest = document.getElementById('close-suggest-event');
  const cancelSuggest = document.getElementById('cancel-suggest-event');

  const setSuggestOpen = (open: boolean) => {
    if (!suggestModal) return;
    suggestModal.classList.toggle('hidden', !open);
    suggestModal.classList.toggle('flex', open);
    document.body.style.overflow = open ? 'hidden' : '';
  };

  openSuggest?.addEventListener('click', () => setSuggestOpen(true));
  closeSuggest?.addEventListener('click', () => setSuggestOpen(false));
  cancelSuggest?.addEventListener('click', () => setSuggestOpen(false));
  suggestModal?.addEventListener('click', (e) => {
    if (e.target === suggestModal) setSuggestOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && suggestModal && !suggestModal.classList.contains('hidden')) {
      setSuggestOpen(false);
    }
  });

  suggestForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!suggestForm || !suggestStatus || !suggestSubmit) return;

    const fd = new FormData(suggestForm);
    const payload = {
      title: String(fd.get('title') || '').trim(),
      eventDate: String(fd.get('eventDate') || '').trim(),
      location: String(fd.get('location') || '').trim(),
      description: String(fd.get('description') || '').trim(),
      suggestedBy: String(fd.get('suggestedBy') || '').trim(),
      suggestedEmail: String(fd.get('suggestedEmail') || '').trim(),
      external: fd.get('external') === 'on',
      website_url: String(fd.get('website_url') || '').trim(),
    };

    suggestSubmit.disabled = true;
    suggestStatus.classList.remove('hidden', 'text-emerald-700', 'text-rose-700');
    suggestStatus.classList.add('text-slate-600');
    suggestStatus.textContent = 'A enviar sugestão…';

    let createdPending = false;

    try {
      const fnRes = await fetch('/.netlify/functions/suggest-event', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...payload,
          eventDate: payload.eventDate ? new Date(payload.eventDate).toISOString() : '',
        }),
      });
      if (fnRes.ok) {
        const result = await fnRes.json();
        createdPending = Boolean(result?.ok);
      }
    } catch {
      // Function unavailable locally / offline — fall through to Netlify Forms
    }

    // Always notify organizers via Netlify Forms
    try {
      const body = new URLSearchParams({
        'form-name': 'event-suggestion',
        title: payload.title,
        eventDate: payload.eventDate,
        location: payload.location,
        description: payload.description,
        suggestedBy: payload.suggestedBy,
        suggestedEmail: payload.suggestedEmail,
        external: payload.external ? 'sim' : 'não',
        website_url: payload.website_url,
        pendingCreated: createdPending ? 'sim' : 'não',
        notifyEmails: suggestForm.dataset.webmasterEmails || '',
      });

      await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString(),
      });
    } catch {
      // Forms may fail in pure local static preview
    }

    suggestStatus.classList.remove('text-slate-600');
    suggestStatus.classList.add('text-emerald-700');
    suggestStatus.textContent = createdPending
      ? 'Sugestão enviada! Ficou pendente de aprovação no painel de administração.'
      : 'Sugestão enviada! A equipa vai rever e publicar se fizer sentido.';

    suggestForm.reset();
    suggestSubmit.disabled = false;

    setTimeout(() => setSuggestOpen(false), 2200);
  });
</script>
