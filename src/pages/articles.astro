---
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
---

<html lang="pt">
  <head>
    <meta charset="utf-8" />
    <title>Artigos - Tertúlias Não Mónó</title>
  </head>
  <body>
    <h1>Artigos</h1>

    {allArticles.length === 0 ? (
      <p>Nenhum artigo encontrado.</p>
    ) : (
      <ul>
        {allArticles.map((article) => (
          <li>
            <h2>{article.data.title}</h2>
            <p><small>Por {article.data.author} em {article.data.date.toLocaleDateString('pt-PT')}</small></p>
          </li>
        ))}
      </ul>
    )}
  </body>
</html>